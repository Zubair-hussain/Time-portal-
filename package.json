{
  "name": "time-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Time Portal — a secure, invite-only time-tracking portal with JWT auth, weekly/monthly insights, and an admin award system. Built with Next.js (static export) + TypeScript + Supabase.",
  "author": "Zubair Hussain <hr070203@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --runInBand",
    "preview:cf": "wrangler dev --port 8787",
    "deploy": "next build && wrangler deploy",
    "audit:security": "npm audit --omit=dev --audit-level=high",
    "audit:lighthouse": "lhci autorun",
    "audit:seo": "node scripts/seo-check.mjs out"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "next": "^15.5.26",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.2.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
