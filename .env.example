# ---------------------------------------------------------------------------
# Time Portal — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit .env.local
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase anon/public key (safe to expose to the browser; RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The Supabase JWT audience/issuer are managed by Supabase automatically.
# The SERVICE ROLE key must NEVER appear here or in client code — admins create
# users from the Supabase dashboard or a trusted server, not the browser.

# Public origin used for canonical URLs, sitemap.xml and robots.txt (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://time-portal.detroonshah.workers.dev
